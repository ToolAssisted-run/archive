{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tar:deletions",
 "type": "object",
 "required": [
  "events"
 ],
 "properties": {
  "comment": {
   "type": "string"
  },
  "events": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "key",
     "title",
     "by",
     "date",
     "reason"
    ],
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "run",
       "game",
       "group",
       "member"
      ]
     },
     "key": {
      "type": "string",
      "description": "run id, sys/slug, group key, or username"
     },
     "title": {
      "type": "string"
     },
     "by": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "reason": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
     },
     "movedTo": {
      "type": "string",
      "description": "where surviving content went (a deleted game names the holding game its runs moved to)"
     }
    }
   }
  }
 }
}
