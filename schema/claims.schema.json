{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tar:claims",
 "type": "object",
 "required": [
  "requests"
 ],
 "properties": {
  "comment": {
   "type": "string"
  },
  "requests": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "member",
     "identity",
     "evidence",
     "date",
     "status"
    ],
    "additionalProperties": false,
    "properties": {
     "member": {
      "type": "string"
     },
     "identity": {
      "type": "string"
     },
     "evidence": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1000
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "status": {
      "enum": [
       "open",
       "approved",
       "denied"
      ]
     },
     "decidedBy": {
      "type": "string"
     },
     "decidedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "note": {
      "type": "string",
      "maxLength": 500
     }
    }
   }
  }
 }
}
