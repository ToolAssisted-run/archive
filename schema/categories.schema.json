{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tar:categories",
 "type": "object",
 "required": [
  "dimensions"
 ],
 "properties": {
  "dimensions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "key",
     "name",
     "options"
    ],
    "properties": {
     "key": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "options": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "key",
        "label",
        "rule"
       ],
       "properties": {
        "key": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "rule": {
         "type": "string"
        },
        "metrics": {
         "type": "array",
         "maxItems": 4,
         "description": "what this category ranks by; order is the tie hierarchy, first is the primary. Absent = the classic real-time metric. key \"time\" is reserved: the derived real time.",
         "items": {
          "type": "object",
          "required": [
           "key",
           "label",
           "type",
           "better"
          ],
          "additionalProperties": false,
          "properties": {
           "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
           },
           "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
           },
           "type": {
            "enum": [
             "time",
             "number"
            ]
           },
           "better": {
            "enum": [
             "lower",
             "higher"
            ]
           },
           "unit": {
            "type": "string",
            "maxLength": 12
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "combos": {
   "type": "object"
  }
 }
}
